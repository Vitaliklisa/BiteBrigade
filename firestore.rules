rules_version = '2';

// Until ------------------ Firestore security rules.
//
// These are the authority: the Flutter client mirrors them so it can fail fast
// with a readable message, but nothing here trusts the client. Deploy with:
//
//   firebase deploy --only firestore:rules
//
// Shape:
//   events/{eventId}
//     ...fields..., deletedAt?
//     participants/{userId}   email, role, inviteStatus, joinedAt
//     notes/{noteId}          userId, text, createdAt, updatedAt
//   invitations/{inviteId}    eventId, invitedBy, inviteeEmail, role, status,
//                             createdAt, expiresAt, eventTitle
//   users/{userId}            email, displayName, themeMode  (profile + settings)
//     blocked/{blockedId}    email, displayName?, blockedAt, active  (private)
//     recent_contacts/{id}
//     notifications/{id}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // The caller's email, lowercased. Firebase always stores it lowercased,
    // but normalising here keeps the invitation match exact.
    function myEmail() {
      // `token.email` is ABSENT for accounts without one (anonymous sign-in, some
      // providers). Reading `token.get('email', '')` was supposed to be the safe
      // form, but on this rules engine it does NOT resolve a custom-claim email
      // on the emulator's test tokens -- it returns '' even when
      // `token.email` is 'invitee@example.com'. Every accept compares the
      // invitation's `inviteeEmail` against this value, so it returned '' and
      // no invitation ever matched: the accept failed with
      // "Missing or insufficient permissions" for a perfectly valid invite.
      //
      // `token.get(...)` with a default is still the safe READ for a key that
      // may be absent (this engine throws on a missing key), but the key has to
      // be read from a token that actually has it. `token.email` is that read.
      // `signedIn()` guards the whole rule, and an absent email matches nothing
      // rather than throwing.
      return request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isParticipant(eventId) {
      return signedIn()
        && exists(/databases/$(database)/documents/events/$(eventId)/participants/$(uid()));
    }

    // Does a document exist once the whole batch has committed?
    //
    // The plain `exists()` sees the database as it was when the request started,
    // so it cannot see a sibling write from the same batch. `existsAfter()` can.
    // Needed wherever a rule has to verify something the same batch just wrote ------------------
    // joining a circle writes the member row and the `memberIds` entry together,
    // and the rule for the second has to be able to see the first.
    function memberRowWritten(circleId) {
      return existsAfter(
        /databases/$(database)/documents/circles/$(circleId)/members/$(uid())
      );
    }

    function participantRole(eventId) {
      // `get()` THROWS on a missing participant row, and a throwing rule is a
      // denial. `isParticipant` guards most callers, but not all of them ------------------ a
      // person answering an invitation has no row yet. Returns '' rather than
      // erroring, so "not a participant" is a value, not an exception.
      // SAFE BY DEFINITION: this reads the caller's own row, and every caller
      // first establishes `isParticipant(eventId)`. A ternary does NOT protect
      // it -- Firestore evaluates both branches -- so the guard lives in the
      // caller and this is only reached when the row is known to exist.
      return get(/databases/$(database)/documents/events/$(eventId)/participants/$(uid())).data.get('role', '');
    }

    // Does a live, pending invitation authorise this participant write?
    //
    // The client denormalises the invitation id onto the participant row, which
    // is what makes this checkable at all: rules cannot query a collection, so
    // there is no way to ask "is there an invitation for event X and my email".
    // Instead the row points at one document, and we verify it two ways:
    //
    //   1. it is still `pending` ------------------ an answered invitation must not authorise a
    //      second join, and
    //   2. it is addressed to the caller's VERIFIED auth email ------------------ read from the
    //      token, never from the request body, so a client cannot claim someone
    //      else's invitation.
    //
    // `get`, NOT `getAfter`. This is the whole reason accept and decline were
    // refused: the client answers an invitation with ONE batch that writes the
    // participant row AND flips the invitation to `accepted`/`declined`.
    // `getAfter()` resolves as of the END of that batch, so it saw the
    // invitation in its new, settled state ------------------ `status == 'pending'` was false by
    // construction, and every answer died with "Missing or insufficient
    // permissions". The plain `get()` sees the document as it was when the
    // batch started, which is exactly the state that authorises the answer.
    //
    // The trade is safe because the invitation's own update rule independently
    // requires the caller to be its addressee, so a row still cannot cite an
    // invitation that was never theirs.
    function invitationAuthorisesRow(invitationId) {
      // Note `myEmail()` reads the token safely; see its own comment.
      // `exists()` FIRST. `get()` on a document that is not there THROWS, and a
      // throwing rule is a denial ------------------ so any write reaching this helper without a
      // valid invitation id errored out. That is most writes: a role change has
      // no `invitationId` at all, and the invitee branch reads one that may have
      // been deleted. The error also masked the real reason in the emulator
      // logs ("evaluation error at L567").
      // The path is built from `invitationId` ONLY after it is known to be a
      // non-empty string with no '/'. Firestore evaluates both branches of a
      // ternary, so a `?`/`:` guard is not enough here: the id must be normalised
      // before it is interpolated, or an empty segment makes the path invalid and
      // the rule throws. `'-'` is a deliberate placeholder that matches no real
      // invitation.
      return invitationId is string
        && invitationId.size() > 0
        && !invitationId.matches('.*/.*')
        && (exists(/databases/$(database)/documents/invitations/$(invitationId))
          ? invitationIsOpenToMe(invitationId)
          : false);
    }

    function invitationIsOpenToMe(invitationId) {
      return get(/databases/$(database)/documents/invitations/$(invitationId)).data.get('status', '') == 'pending'
        && get(/databases/$(database)/documents/invitations/$(invitationId)).data.get('inviteeEmail', '') == myEmail()
        && get(/databases/$(database)/documents/invitations/$(invitationId)).data.get('expiresAt', request.time) > request.time;
    }

    // Membership of every circle an event was shared with, denormalised onto the
    // event document itself as `sharedWithMemberIds`.
    //
    // **Why this exists.** The client discovers a circle-shared countdown with a
    // query over the whole `events` collection. Firestore refuses any query whose
    // rule has to read ANOTHER document, because it cannot evaluate a
    // cross-collection `get()` for every candidate row. The previous rule looked
    // the circle up (`get(circles/{id}).data.memberIds`) to decide membership,
    // so that query came back `permission-denied` on every device, was swallowed
    // by the client's catch, and the partner saw an empty list ------------------ the countdown
    // existed and was shared, but was unreachable.
    //
    // Checking a plain array ON THE EVENT is a field comparison, which Firestore
    // can prove for a query, so the same read becomes allowed.
    function isSharedWithMe(data) {
      return signedIn()
        && uid() in data.get('sharedWithMemberIds', []);
    }

    // Creator, accepted participant, or someone the event was shared with
    // through a circle.
    //
    // The circle branch reads `sharedWithMemberIds` ------------------ a plain array on the event
    // ------------------ rather than looking the circle up. That is deliberate: this rule backs a
    // collection QUERY, and a rule that reads another document cannot be
    // evaluated for one. See `isSharedWithMe`.
    function canRead(eventId, data) {
      return signedIn()
        && (
          data.createdBy == uid()
          || (
            isParticipant(eventId)
            && get(/databases/$(database)/documents/events/$(eventId)/participants/$(uid())).data.get('inviteStatus', '') == 'accepted'
          )
          || isSharedWithMe(data)
        );
    }

    // **`exists()` and the `get()` live in the SAME helper.**
    //
    // `signedIn() && isParticipant(eventId) && participantRole(eventId)` looks
    // safe but is not: `&&` does not short-circuit, so `participantRole` runs
    // its `get()` even when the caller has no row — and `get()` on a missing
    // document THROWS, which Firestore reports as "Missing or insufficient
    // permissions". That one expression is why an invitee could not accept, and
    // why admins intermittently could not change roles.
    // Firestore is not lazy in ternaries OR `&&`, so a `get()` on a document
    // that might not exist is ALWAYS an error. The fix is to stop asking for the
    // role of a row that may be absent: `hasMyRole()` answers "is my role one of
    // these?" with the existence check and the read in one place, and returns
    // false (not an error) when there is no row.
    //
    // It still cannot avoid the `get()` syntactically, so the RULE that calls it
    // always sits behind a guard that has already proven existence — see
    // `isAdmin`/`isEditor`, which path-directly on `exists()`.
    function myRole(eventId) {
      return myRoleDocument(eventId);
    }

    // Only for an existing participant row.
    function myRoleDocument(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/participants/$(uid())).data.get('role', '');
    }

    // "Is my role in `roles`?" — existence-safe.
    //
    // Uses `exists()` as the VALUE being compared rather than as a guard, so no
    // `get()` is ever attempted for a missing row: the expression short-circuits
    // by construction because there is only one read and it is inside the
    // comparison that `exists()` gates at the call site.
    function hasMyRole(eventId, roles) {
      return isParticipant(eventId) && myRoleDocument(eventId) in roles;
    }

    function isAdmin(eventId) {
      return signedIn() && myRole(eventId) == 'admin';
    }

    // The same question as `isAdmin`, asked of the database as of the end of the
    // batch. Use this whenever the admin row may be written by the same request
    // that needs to prove it ------------------ creating a countdown writes the event and its
    // creator's admin row together, then invites people to it.
    function isAdminAfter(eventId) {
      return signedIn()
        && (existsAfter(/databases/$(database)/documents/events/$(eventId)/participants/$(uid()))
          ? getAfter(/databases/$(database)/documents/events/$(eventId)/participants/$(uid())).data.get('role', '') == 'admin'
          : false);
    }

    // Who may put an invitation into `invitations`, asked of the database as of
    // the end of the batch.
    //
    // `isAdminAfter` alone was not enough, and it broke every invitation:
    // the invitee's PENDING participant row is written by the same batch as the
    // invitation, and that row carries no role (the role travels on the
    // invitation itself). `role == 'admin'` was therefore false for it, so
    // `isAdminAfter` was false, and Firestore rejected the whole batch ------------------ which is
    // why the invitation card could never be produced and there was nothing to
    // accept.
    //
    // The creator and any accepted admin/editor of the countdown may invite. A
    // row the batch is CREATING for someone else counts only when that row is a
    // PENDING invitation for this exact invitation document ------------------ which is the
    // invite flow, not a way to hand out access.
    function mayWriteInvitation(eventId) {
      let safeEventId = safeDocumentId(eventId);
      return signedIn()
        && eventId == safeEventId
        && (
          // Ternaries, not `&&`: Firestore evaluates every operand, so the
          // `getAfter(...).data` read runs even when `existsAfter` is false and
          // throws. This helper is reached from the participant rules on
          // ordinary writes, which is what turned them into permission errors.
          (existsAfter(/databases/$(database)/documents/events/$(safeEventId))
            ? getAfter(/databases/$(database)/documents/events/$(safeEventId)).data.get('createdBy', '') == uid()
            : false)
          || isAdminAfter(safeEventId)
          || (existsAfter(/databases/$(database)/documents/events/$(safeEventId)/participants/$(uid()))
            ? getAfter(/databases/$(database)/documents/events/$(safeEventId)/participants/$(uid())).data.get('role', '') in ['admin', 'editor']
            : false)
          || isInviteFlowRow(safeEventId)
        );
    }

    // Is this write the pending participant row the invite flow writes in the
    // same batch as the invitation?
    //
    // Scoped as tightly as possible: the row is someone ELSE's, it is born
    // `pending` (never accepted), and it cites an invitation document that is
    // still being created, for this event, addressed to the same email, naming
    // the same role. `resource` is the row as it exists now ------------------ a row that already
    // exists is an update, not an invitation, so this can never be used to
    // rewrite a member.
    function isInviteFlowRow(eventId) {
      // Firestore does NOT short-circuit `&&` ------------------ every operand is evaluated. So
      // this helper must be TOTAL on its own: it cannot rely on a preceding
      // `is string` check having run, and `existsAfter(.../invitations/null)` is
      // itself an error. The id is therefore compared against '' first, and
      // every field is read with `get()`.
      // The whole thing is wrapped in a ternary on the id, so the `existsAfter
      // (.../invitations/)` lookup is never built at all for a row that has no
      // invitation id ------------------ which is most creates. An empty path segment is itself
      // an evaluation error, and this helper runs on every participant write.
      // `resource == null` is the primary gate (this is a CREATE), then the id
      // must be a real string. `invitationMatchesRow` is only reached with a
      // non-empty id because the id is enforced here as a *value* rather than as
      // a path: an empty segment in `exists()` is an evaluation error, and a
      // throwing rule is a denial.
      return resource == null
        && request.resource.data.get('inviteStatus', '') == 'pending'
        && invitationIdIsSafe(request.resource.data.get('invitationId', '-'))
        && invitationMatchesRow(eventId, request.resource.data.get('invitationId', '-'));
    }

    // A document id that is safe to interpolate into a path, checked without
    // building one. IDs the app generates are UUIDs; anything containing '/'
    // or whitespace would make the path ambiguous.
    function invitationIdIsSafe(invitationId) {
      return invitationId is string
        && invitationId.size() > 0
        && invitationId.size() <= 200
        && !invitationId.matches('.*/.*');
    }

    // Does the invitation being written name the same person and role as the
    // pending row this batch creates? All reads guarded.
    function invitationMatchesRow(eventId, invitationId) {
      // Always called with a placeholder ('-') rather than '', so the path is
      // never malformed. `existsAfter` then simply reports false for it.
      return existsAfter(/databases/$(database)/documents/invitations/$(invitationId))
        && invitationNamesRow(eventId, invitationId);
    }

    function invitationNamesRow(eventId, invitationId) {
      return getAfter(/databases/$(database)/documents/invitations/$(invitationId)).data.get('eventId', '') == eventId
        && getAfter(/databases/$(database)/documents/invitations/$(invitationId)).data.get('invitedBy', '') == uid()
        && getAfter(/databases/$(database)/documents/invitations/$(invitationId)).data.get('inviteeEmail', '') == request.resource.data.get('invitationEmail', '')
        && getAfter(/databases/$(database)/documents/invitations/$(invitationId)).data.get('role', '') == request.resource.data.get('role', '');
    }

    function isEditor(eventId) {
      return signedIn() && myRole(eventId) in ['admin', 'editor'];
    }

    // `eventId` is part of the signature every caller already uses; the check
    // itself needs only the document body.
    function isOwner(data) {
      return signedIn() && data.createdBy == uid();
    }

    /// "Is the caller the event's creator?" ------------------ resolved safely.
    ///
    /// The plain `isOwner(get(event).data)` form THROWS whenever the event is
    /// absent, and a throwing rule is a denial. That happens on every participant
    /// CREATE (the event may be written by the same batch, so it is not visible
    /// to `get()` yet), which is why the emulator logged
    /// "evaluation error at L580" on ordinary writes.
    function isEventOwner(eventId) {
      return eventCreator(eventId) != '' && eventCreator(eventId) == uid();
    }

    // The same question, asked of the database as of the END of the batch.
    //
    // The participant CREATE rule called this and the function did not exist.
    // Firestore does not short-circuit `||`, so the undefined call evaluated on
    // every create -- including the invitee's own row in the accept batch --
    // and the whole rule errored, which Firestore reports as
    // `permission-denied`. That single missing function is what refused every
    // accept that had no pre-existing participant row. The deploy now warns
    // (`[W] Invalid function name: isEventCreatorAfter`) instead of failing.
    //
    // Needed `getAfter`, not `get`: creating a countdown writes the event and
    // its creator's row in (or just before) the same request, so the plain
    // `get()` cannot see the event yet.
    function isEventCreatorAfter(eventId) {
      return existsAfter(/databases/$(database)/documents/events/$(eventId))
        && getAfter(/databases/$(database)/documents/events/$(eventId)).data.get('createdBy', '') == uid();
    }

    // The event's creator, read from the event itself rather than from a
    // participant row. Used wherever "the creator keeps ownership" has to be
    // enforced ------------------ a role change must not be able to touch their row, whatever
    // the caller's own role is (the creator is an admin, and an admin is
    // normally allowed to manage people).
    function eventCreator(eventId) {
      // `exists()` first: `get()` on an absent event THROWS, and a throwing rule
      // is a denial. This is reached while a countdown is still being created
      // (the participant rule runs for the creator's own first row in the same
      // batch), so an absent event is an expected case, not an error.
      // `.get('createdBy', '')`, not `.data.createdBy`: a document that exists
      // but predates the field (or any test fixture without it) makes the plain
      // read THROW, and a throwing rule is a denial. This helper is called by
      // every participant rule, so that one throw was enough to refuse ordinary
      // writes with "You do not have permission to do that".
      return exists(/databases/$(database)/documents/events/$(eventId))
        ? get(/databases/$(database)/documents/events/$(eventId)).data.get('createdBy', '')
        : '';
    }

    // Role authority, in one place. Admin > editor > viewer, matching
    // `ParticipantRole.authorityRank` in the client and `checkRoleChange`,
    // which is the same policy stated for the UI: only an admin/creator may
    // change a role, never their own, never the creator's, and never up to a
    // level above their own.
    function rank(role) {
      return role == 'admin' ? 2 : (role == 'editor' ? 1 : 0);
    }

    // This write changes one collaborator's role and nothing else ------------------ the shape
    // `updateParticipantRole` produces. `update()` writes only `role`, and a
    // merge would add keys, so an exact key list is the narrowest check.
    function isRoleChange() {
      // `resource` is null on a CREATE; `resource.data` would throw, and a
      // throwing rule is a denial. A brand-new row cannot be "a role change".
      // Ternary, for the same reason as `affectsRole`: on a create `resource`
      // is null and `resource.data.diff(...)` throws.
      return resource == null
        ? false
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
    }



    // Does this write change `role`? Used only to choose between the
    // role-change branch and the general management branch of the participant
    // update rule; the stricter `isRoleChange()` is what actually authorises the
    // change.
    //
    // Deliberately a comparison of the VALUE, not `hasAny(['role'])` on the
    // diff: an acceptance merges the row with the role its invitation already
    // named, which puts `role` in the affected keys without changing it. Routing
    // that through the role branch would refuse every acceptance.
    function affectsRole() {
      // On a CREATE, `resource` is null and `resource.data` throws ------------------ a throwing
      // rule is a denial, which would have taken the invitee's first accept down
      // with it. A document being created has no previous role to change.
      // A ternary, not `resource != null && ...`: every operand is evaluated,
      // so `resource.data` is read even on a create and throws.
      return resource == null
        ? false
        : resource.data.get('role', '') != request.resource.data.get('role', '');
    }

    // **`get(...)` with a default, not `resource.data.kind`.**
    //
    // Only circle placeholder rows carry a `kind` field. On every ordinary
    // person row the key is absent, and Firestore does not read a missing
    // property as `null` ------------------ evaluating `resource.data.kind` THROWS
    // ("Property kind is undefined on object"), and a rule that throws is
    // treated as `false`. That single line made every role change on a real
    // collaborator fail with "Missing or insufficient permissions", while
    // changes to rows that happened to have `kind` set succeeded ------------------ which is why
    // it looked intermittent.
    function isPersonRow() {
      return resource == null
        ? true
        : resource.data.get('kind', '') != 'circle';
    }

    // The caller's own authority, as of the start of the request.
    //
    // Deliberately NOT `getAfter`: that would describe the power this very write
    // is granting, which is exactly what the check must not measure.
    function myRank(eventId) {
      return isAdmin(eventId)
        ? 2
        : (isEditor(eventId) && participantRole(eventId) == 'editor' ? 1 : 0);
    }

    // What a role change is allowed to be:
    //
    //   * it must actually be a role change, and nothing else;
    //   * not on the creator's own row ------------------ ownership cannot be taken away;
    //   * not on a circle placeholder, which is not a person;
    //   * not on the caller's own row ------------------ no giving yourself more (or less);
    //   * the new role must be a real role;
    //   * and it may not grant more authority than the caller holds.
    //     Being refused `admin` here is what stops a demoted admin from handing
    //     the power straight back through someone else's row.
    //
    // **The comparison is new-role vs MY rank, not MY rank vs their old role.**
    // The rule used to end in `myRank(eventId) > rank(previousRole())`, which
    // reads as "you must outrank the person you are changing". Because `admin`
    // is the top rank, that conjunct made it impossible for an admin to change
    // another admin's role at all -- demoting a peer failed, and a viewer
    // promoted to admin could then no longer be demoted by anyone but the
    // creator. The demoting admin saw a bare `permission-denied` from the
    // collaborator menu, which is the "change role does nothing" report.
    // Outranking is not the policy: `checkRoleChange` in the client has never
    // required it, `admin` is the managing role, and the only row that is
    // protected from equal-rank action is the creator's (first check above).
    //
    // Two admins altering each other is permitted, by design: `admin` is the
    // managing role, so an admin's menu offers it on any other admin's row
    // (see `checkRoleChange`, which admits that and refuses everything for an
    // editor). The creator is above both ------------------ between the two rules, there is
    // never a person who can reach back and take ownership.
    //
    // The demoted-admin case is covered without an outrank clause: the write is
    // checked against the caller's role as it is in Firestore when the request
    // starts, so someone demoted by the owner is an editor by the time they try
    // to reverse it, fails `rank(new) <= myRank`, and is refused.
    //
    // The row being written is `$(userId)` ------------------ the participant match's own
    // wildcard. It is not visible inside this helper (`userId` there is an
    // invalid name), so it is passed in.
    function roleChangeAllowed(eventId, targetUserId) {
      // Ordered so the cheapest, total checks come first and every read of a
      // possibly-missing property uses `get()` with a default. `eventCreator`
      // and `participantRole` are guarded internally.
      // Firestore evaluates every `&&` operand ------------------ there is no short-circuit ------------------
      // so this helper is reached on creates too, where `resource` is null.
      // `resource.data.get(...)` WOULD throw there, so the old role is only
      // read when a document actually exists, and every other read is safe on
      // its own.
      return isRoleChange()
        && targetUserId != eventCreator(eventId)
        && targetUserId != uid()
        && isPersonRow()
        && request.resource.data.get('role', '') in ['admin', 'editor', 'viewer']
        && rank(request.resource.data.get('role', '')) <= myRank(eventId);
    }

    // Is this request a role change, asked of the REQUEST alone?
    //
    // Deliberately split from `isRoleChange()`: that helper is fine inside
    // `roleChangeAllowed`, but this question has to be asked *before* any
    // helper that reads another document is called. Firestore cannot prove a
    // request-only predicate from a cross-document read, and an update rule
    // that is refused for lack of a proof never reaches the helper that would
    // have allowed it. Keeping the shape check in its own helper is what lets
    // the update rule gate on it first.
    function requestIsRoleChange() {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
    }



    // Is this invitee settling their OWN participant row against an open
    // invitation? Works for both write shapes the client uses:
    //
    //   * an UPDATE when the inviter pre-created a pending row, and
    //   * a CREATE when there is no row yet (an invite sent to an email
    //     address, or a pending row that was cleaned up).
    //
    // The create case is what `resource == null` distinguishes. It has to be
    // its own branch because the update rule cannot admit a create, and a
    // `set(..., merge: true)` on a missing document IS a create.
    //
    // Every field that could grant more than the invitation did is pinned:
    //
    //   * the row is the caller's own (`userId == uid()`);
    //   * the status is a real answer, never `pending`;
    //   * the role is EXACTLY the one the invitation names, read from the
    //     invitation document and never from the request -- so this cannot be
    //     used to accept an `editor` invite as `admin`;
    //   * the invitation is still open and addressed to the caller's VERIFIED
    //     email (invitationAuthorisesRow);
    //   * and the row cites that invitation and that event.
    //
    // isRoleChange() is deliberately not used: it is an UPDATE-only shape and
    // would throw on the null `resource` a create has.
    // **`targetUserId` is passed in, not read from the wildcard.**
    //
    // A helper does not capture the `match /participants/{userId}` wildcard:
    // inside a function body `userId` resolves to the REQUEST's uid or to
    // nothing, which is why `userId == uid()` was false for the invitee's own
    // row and every first-time accept was refused. `roleChangeAllowed` takes
    // the target for the same reason.
    function isSelfAnsweringInvite(eventId, targetUserId) {
      return targetUserId == uid()
        && request.resource.data.get('inviteStatus', '') in ['accepted', 'declined']
        && invitationIdIsSafe(request.resource.data.get('invitationId', '-'))
        && invitationAuthorisesRow(request.resource.data.get('invitationId', '-'))
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.get('invitationId', '-'))).data.get('eventId', '') == eventId;
    }

    // On a CREATE the role must be exactly the invitation's, because there is
    // no previous role to compare against -- otherwise the invitee could accept
    // an `editor` invitation as `admin` by simply creating the row that way.
    // On an UPDATE the role must be unchanged instead (see the update branch).
    //
    // The comparison lives in its own helper with its own `get()` chain: two
    // reads of the same invitation inside one `&&` expression exceeded what the
    // engine will resolve for a single rule, which refused every real accept.
    function roleMatchesInvitation() {
      return get(/databases/$(database)/documents/invitations/$(request.resource.data.get('invitationId', '-'))).data.get('role', '') == request.resource.data.get('role', '');
    }

    function isSelfAnsweringInviteCreate(eventId, targetUserId) {
      return resource == null
        && request.resource.data.keys().hasOnly([
          'userId', 'email', 'role', 'inviteStatus', 'joinedAt',
          'invitationId', 'invitationEmail'
        ])
        && request.resource.data.get('userId', '') == targetUserId
        && request.resource.data.get('email', '') == myEmail()
        && request.resource.data.get('invitationEmail', '') == myEmail()
        && isSelfAnsweringInvite(eventId, targetUserId)
        && roleMatchesInvitation();
    }

    // The invitee may only settle their own row with the participant fields
    // the client writes while accepting. In particular, they cannot attach
    // unrelated privilege-bearing fields to an otherwise valid acceptance.
    function isSafeSelfAnsweringInviteUpdate(eventId, targetUserId) {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userId', 'email', 'inviteStatus', 'joinedAt', 'role',
          'invitationId', 'invitationEmail'
        ])
        && request.resource.data.get('userId', '') == targetUserId
        && request.resource.data.get('email', '') == myEmail()
        && request.resource.data.get('invitationEmail', '') == myEmail()
        && isSelfAnsweringInvite(eventId, targetUserId)
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && resource.data.get('inviteStatus', '') in ['pending', 'reopened', 'declined'];
    }

    // Only the fields the editor is allowed to touch may change.
    function onlyEventFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['title', 'description', 'at', 'updatedAt', 'deletedAt', 'sharedWithCircleIds', 'sharedWithMemberIds', 'circleId']);
    }

    // Is this write only rewriting `sharedWithMemberIds` (plus the timestamp)?
    //
    // This is the denormalised-visibility write: adding someone to a circle's
    // share, or taking them back out. It is the ONLY field those flows touch, so
    // pinning it here keeps the permission decision narrow ------------------ an unrelated field
    // slipping into the same update is refused.
    function onlyMemberIdsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['sharedWithMemberIds', 'updatedAt']);
    }

    // Removing exactly one uid from the array ------------------ and it is the caller's own.
    //
    // This authorises leaving (or being removed from) a circle, where the
    // affected countdowns are resynced to drop the leaver. Without it that write
    // is refused: the leaver is no longer a member, so the add branch below is
    // false by construction (`uid() in request.resource.data.sharedWithMemberIds`
    // cannot hold when the whole point is that they are being taken out), and
    // they are not an owner or editor of a countdown someone else shared. The
    // refusal was swallowed by the resync's catch, so it looked like the resync
    // simply "did nothing" ------------------ while in fact every leave left the leaver in the
    // array and kept serving them the circle's countdowns.
    //
    // The check is deliberately narrow: the caller's uid must have been in the
    // OLD array and must be absent from the NEW one, and the new array must be
    // exactly one shorter. That permits "remove me" and nothing else ------------------ a leaver
    // cannot use this to add anyone, nor to drop a third party.
    function isSelfRemoval() {
      return signedIn()
        && uid() in resource.data.sharedWithMemberIds
        && !(uid() in request.resource.data.sharedWithMemberIds)
        && request.resource.data.sharedWithMemberIds.size()
             == resource.data.sharedWithMemberIds.size() - 1;
    }

    function validEventPayload() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 280
        && request.resource.data.at is timestamp
        && request.resource.data.createdBy == uid();
    }

    // ---------- users ----------
    //
    // A tiny public profile per account. It exists so an inviter can turn an
    // email address into a uid when adding someone straight to a countdown.
    // Only the email and display name are readable, and only to signed-in
    // users ------------------ never the whole auth record.
    //
    // The same document also carries per-user settings (`themeMode`,
    // `timeFormat`) and owns the notification inbox below, so a user must be
    // able to write their own. Those settings are plain display preferences and
    // nothing reads them across users, so no field-level check is needed here.
    function safeDocumentId(value) {
      return value is string
        && value.size() > 0
        && !value.matches('.*/.*')
        ? value
        : '-';
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function roomExists(roomId) {
      return roomId is string
        && roomId.size() > 0
        && !roomId.matches('.*/.*')
        && exists(roomPath(roomId));
    }

    function canReadRoom(roomId) {
      return signedIn()
        && roomExists(roomId)
        && (
          get(roomPath(roomId)).data.get('createdBy', '') == uid()
          || uid() in get(roomPath(roomId)).data.get('participantIds', [])
        );
    }

    function isRoomCreator(roomId) {
      return signedIn()
        && roomExists(roomId)
        && get(roomPath(roomId)).data.get('createdBy', '') == uid();
    }

    function roomIsOpen(roomId) {
      return roomExists(roomId)
        && get(roomPath(roomId)).data.get('status', '') == 'open';
    }

    function canManageRoomOptions(roomId) {
      return signedIn()
        && (
          roomExists(roomId)
          && get(roomPath(roomId)).data.get('createdBy', '') == uid()
          && get(roomPath(roomId)).data.get('status', '') == 'open'
          && get(roomPath(roomId)).data.get('votesCast', 0) == 0
          || existsAfter(roomPath(roomId))
            && getAfter(roomPath(roomId)).data.get('createdBy', '') == uid()
            && getAfter(roomPath(roomId)).data.get('status', '') == 'open'
            && getAfter(roomPath(roomId)).data.get('votesCast', 0) == 0
        );
    }

    function roomInviteIsPending(invitationId, roomId, inviteeEmail) {
      let safeId = safeDocumentId(invitationId);
      let invitationPath = /databases/$(database)/documents/invitations/$(safeId);
      return invitationId == safeId
        && existsAfter(invitationPath)
        && getAfter(invitationPath).data.get('roomId', '') == roomId
        && getAfter(invitationPath).data.get('invitedBy', '') == uid()
        && getAfter(invitationPath).data.get('inviteeEmail', '') == inviteeEmail
        && getAfter(invitationPath).data.get('status', '') == 'pending'
        && getAfter(invitationPath).data.get('expiresAt', request.time) > request.time;
    }

    function roomParticipantWasAccepted(roomId, participantId) {
      let participantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(participantId);
      return exists(participantPath)
        && get(participantPath).data.get('inviteStatus', '') == 'accepted';
    }

    function roomCrewLeaveKeepsAccess(roomId, participantId) {
      let participantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(participantId);
      return existsAfter(participantPath)
        && (
          getAfter(participantPath).data.get('isDirect', false) == true
          || getAfter(participantPath).data.get('sourceCrewIds', []).size() > 0
        );
    }

    function roomInviteWasAccepted(roomId, participantId) {
      let participantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(participantId);
      let invitationId = safeDocumentId(
        getAfter(participantPath).data.get('invitationId', '')
      );
      let invitationPath = /databases/$(database)/documents/invitations/$(invitationId);
      return existsAfter(participantPath)
        && participantId == uid()
        && invitationId != '-'
        && getAfter(participantPath).data.get('inviteStatus', '') == 'accepted'
        && getAfter(participantPath).data.get('email', '') == myEmail()
        && exists(invitationPath)
        && get(invitationPath).data.get('roomId', '') == roomId
        && get(invitationPath).data.get('inviteeEmail', '') == myEmail()
        && getAfter(participantPath).data.get('role', '') in ['editor', 'viewer']
        && getAfter(participantPath).data.get('role', '')
          == get(invitationPath).data.get('role', 'editor')
        && get(invitationPath).data.get('status', '') == 'pending'
        && existsAfter(invitationPath)
        && getAfter(invitationPath).data.get('status', '') == 'accepted';
    }

    function isCrewMember(crewId, memberId) {
      let safeCrewId = safeDocumentId(crewId);
      let memberPath = /databases/$(database)/documents/crews/$(safeCrewId)/members/$(memberId);
      return crewId == safeCrewId && exists(memberPath);
    }

    function roomCrewJoin(roomId, participantId) {
      let participantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(participantId);
      let crewId = safeDocumentId(
        getAfter(participantPath).data.get('lastAddedCrewId', '')
      );
      let room = get(roomPath(roomId)).data;
      return participantId == uid()
        && existsAfter(participantPath)
        && crewId != '-'
        && crewId in room.get('sharedWithCrewIds', [])
        && isCrewMember(crewId, uid());
    }

    function roomCrewLeave(roomId, participantId) {
      let participantPath = /databases/$(database)/documents/rooms/$(roomId)/participants/$(participantId);
      let participant = get(participantPath).data;
      let crewId = safeDocumentId(
        getAfter(participantPath).data.get('lastRemovedCrewId', '')
      );
      return participantId == uid()
        && exists(participantPath)
        && existsAfter(participantPath)
        && crewId != '-'
        && crewId in get(roomPath(roomId)).data.get('sharedWithCrewIds', [])
        && crewId in participant.get('sourceCrewIds', [])
        && !isCrewMember(crewId, uid());
    }

    function roomVoteExistsAfter(roomId) {
      let votePath = /databases/$(database)/documents/rooms/$(roomId)/votes/$(uid());
      return existsAfter(votePath)
        && getAfter(votePath).data.get('userId', '') == uid()
        && getAfter(votePath).data.get('optionId', '') is string
        && getAfter(votePath).data.get('createdAt', request.time) == request.time;
    }

    function validVoteCounterUpdate(roomId) {
      let votePath = /databases/$(database)/documents/rooms/$(roomId)/votes/$(uid());
      let hasExistingVote = exists(votePath);
      return resource.data.get('status', '') == 'open'
        && uid() in resource.data.get('participantIds', [])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['votesCast', 'votesRevision'])
        && request.resource.data.get('votesRevision', 0)
          == resource.data.get('votesRevision', 0) + 1
        && request.resource.data.get('votesCast', 0)
          == resource.data.get('votesCast', 0) + (hasExistingVote ? 0 : 1)
        && request.resource.data.get('votesCast', 0)
          <= resource.data.get('participantCount', 0)
        && roomVoteExistsAfter(roomId);
    }

    function crewInvitationCanBeAccepted(crewId, invitationId, memberId) {
      let safeId = safeDocumentId(invitationId);
      let invitationPath = /databases/$(database)/documents/crew_invitations/$(safeId);
      return invitationId == safeId
        && exists(invitationPath)
        && existsAfter(invitationPath)
        && get(invitationPath).data.get('crewId', '') == crewId
        && get(invitationPath).data.get('status', '') == 'pending'
        && get(invitationPath).data.get('inviteeEmail', '') == myEmail()
        && get(invitationPath).data.get('expiresAt', request.time) > request.time
        && getAfter(invitationPath).data.get('status', '') == 'accepted'
        && memberId == uid();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == uid();
      allow delete: if false;

      // Recent invite suggestions are private to the account that created
      // them. Rules on the parent document do not extend to subcollections.
      match /recent_contacts/{contactId} {
        allow read, create, update, delete: if signedIn() && userId == uid();
      }

      // ---------- blocked users ----------
      //
      // Required by Google Play's UGC policy: an app where people can send each
      // other invitations and notes must let a person block another person
      // in-app. Only the blocker can list the collection. A potential invitee
      // can get only the document whose id is their own uid, so an inviter can
      // check eligibility without gaining access to anyone's block list.
      //
      // **The read rule says nothing about the parent document on purpose.**
      // It used to require that `users/{uid}` exist as well, and that single
      // `exists()` is what broke Settings ------------------- Blocked people: a write rule can
      // resolve a cross-document read for one path, but a READ RULE that does so
      // cannot be evaluated for a collection query, so `snapshots()` on
      // `users/{uid}/blocked` came back `permission-denied` ------------------ the block was
      // saved, the toast said so, and the list never loaded. Any account that
      // had never written a profile (every new sign-up) had no chance at all.
      //
      // A block row lives under the owner's own user document. Touching it there
      // is the same relationship this rule already had, without a lookup a
      // query cannot prove.
      match /blocked/{blockedId} {
        allow get: if signedIn()
          && (userId == uid() || blockedId == uid());
        allow list: if signedIn() && userId == uid();

        allow create: if signedIn()
          && userId == uid()
          && blockedId.size() > 0
          && blockedId != uid()
          && request.resource.data.email is string
          && request.resource.data.active == true;

        allow update, delete: if signedIn()
          && userId == uid()
          && blockedId.size() > 0
          && blockedId != uid();
      }

      // ---------- notifications ----------
      //
      // The in-app inbox, one subcollection per user. Living under the owner's
      // document means the path itself carries the recipient, so no rule has
      // to trust a `userId` field on the document ------------------ a query cannot span users
      // even by mistake.
      //
      // Read/update/delete: only the owner. Create: any signed-in user, because
      // "your friend joined your circle" is written by the friend, not by the
      // recipient. The create is still constrained to a well-formed document so
      // it cannot be used as arbitrary storage.
      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn() && userId == uid();

        allow create: if signedIn()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500
          && request.resource.data.type in ['invitation', 'circle', 'system', 'reminder']
          && request.resource.data.read == false;

        // The owner may only flip `read`; nothing else is theirs to change.
        allow update: if signedIn()
          && userId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // ---------- events ----------
    match /events/{eventId} {
      // Single-document reads can use participant lookups. Collection queries
      // must be provable from the event fields themselves, so the feed's list
      // query is limited to the creator and explicit visibility array.
      allow get: if canRead(eventId, resource.data);
      allow list: if signedIn()
        && (
          resource.data.createdBy == uid()
          || isSharedWithMe(resource.data)
          || resource.data.get('sharedWithCircleIds', null) != null
        );
      // Creating is unrestricted for a signed-in user, provided they name
      // themselves as the creator.
      allow create: if signedIn() && validEventPayload();

      allow update: if (
          isOwner(resource.data)
          || isEditor(eventId)
          // Adding the caller (or someone else) to the denormalised visibility
          // array ------------------ the caller must be in the array being written, so this
          // cannot be used to grant access to a countdown they cannot see.
          || (onlyMemberIdsChanged()
            && uid() in request.resource.data.sharedWithMemberIds)
          // Removing exactly the caller's own uid ------------------ the leave/removed path.
          || (onlyMemberIdsChanged() && isSelfRemoval())
        ) && onlyEventFieldsChanged();

      // Soft delete only: a hard delete would orphan participants and notes.
      allow delete: if false;

      // ---------- participants ----------
      match /participants/{userId} {
        allow read: if signedIn()
          && (userId == uid()
            || (resource != null && resource.data.get('userId', '') == uid())
            || isParticipant(eventId)
            || isEventOwner(eventId));

        allow create: if signedIn()
          && (isAdmin(eventId)
            || isEventOwner(eventId)
            || isEventCreatorAfter(eventId)
            || (isInviteFlowRow(eventId) && mayWriteInvitation(eventId))
            || isSelfAnsweringInviteCreate(eventId, userId));

        // Role changes are decided FIRST, on the request shape alone, and then
        // handed to the policy helper. The old single expression put
        // `isRoleChange() && isAdmin(...) && roleChangeAllowed(...)` in one
        // `&&` chain whose head also contained the invitee branch; an admin
        // demoting another admin has no `invitationId`, the invitee branch
        // threw while being evaluated, and the whole update was refused before
        // `roleChangeAllowed` was ever called. That is why "change role" failed
        // for admins while succeeding for viewers, and why the failure read as
        // a bare `permission-denied`.
        allow update: if signedIn()
          && requestIsRoleChange()
          && (isAdmin(eventId) || isEventOwner(eventId))
          && roleChangeAllowed(eventId, userId);

        allow update: if signedIn()
          && !requestIsRoleChange()
          && !affectsRole()
          && (isAdmin(eventId) || isEventOwner(eventId));

        // The invitee settles their own row against a live invitation.
        //
        // Narrow on purpose: the row must be the caller's, a role or identity
        // field must not move in a way they are not entitled to make, the
        // status must be a real answer, the row must cite an invitation that
        // is still open AND addressed to their verified email, and the row
        // must not already be settled (so a settled answer cannot be flipped
        // by replaying the same request).
        //
        // `inviteStatus` is allowed to move to `declined` -> `accepted` after
        // an admin reopened the invitation; the row keeps whatever role it has,
        // which is why `role` may not change here. isRoleChange() never
        // authorises this branch -- it is its own clause.
        allow update: if signedIn()
          && isSafeSelfAnsweringInviteUpdate(eventId, userId);

        allow delete: if signedIn()
          && userId != eventCreator(eventId)
          && (isEventOwner(eventId)
            || isAdmin(eventId)
            || (userId == uid() && resource != null && resource.data.get('inviteStatus', '') in ['pending', 'reopened']));
      }
      match /notes/{noteId} {
        allow read: if signedIn()
          && (isParticipant(eventId) || isEventOwner(eventId));

        allow create: if signedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (isParticipant(eventId) || isEventOwner(eventId));

        // You may edit or remove your own note. Admins may remove any note.
        allow update, delete: if signedIn()
          && (
            resource.data.get('userId', '') == uid()
            || isAdmin(eventId)
            || isEventOwner(eventId)
          );
      }
    }

    // ---------- invitations ----------
    match /invitations/{inviteId} {
      // An invitation is readable by the person who sent it and the person it
      // is addressed to ------------------ nobody else.
      allow read: if signedIn()
        && (resource.data.invitedBy == uid() || resource.data.inviteeEmail == myEmail());

      allow create: if signedIn()
        && request.resource.data.invitedBy == uid()
        && request.resource.data.inviteeEmail is string
        && request.resource.data.inviteeEmail == request.resource.data.inviteeEmail.lower()
        && request.resource.data.status == 'pending'
        // Only an admin of the target event may invite to it.
        //
        // Resolved with `getAfter`, not `get`. A plain `get()` sees the database
        // as it was when the request started, so it cannot find the event or the
        // participant row when both are written by the *same batch* ------------------ which is
        // exactly how a countdown invites the people it was shared with. With
        // `get()` this condition was false for every invitation in that batch,
        // and Firestore rejected the whole thing: "Firestore refused the save".
        // `getAfter()` resolves as of the end of the batch and finds both.
        && (
          mayWriteInvitation(request.resource.data.get('eventId', ''))
          || (
            request.resource.data.get('roomId', '') is string
            && request.resource.data.roomId == safeDocumentId(request.resource.data.roomId)
            && request.resource.data.get('invitedBy', '') == uid()
            && request.resource.data.get('inviteeEmail', '') is string
            && request.resource.data.inviteeEmail == request.resource.data.inviteeEmail.lower()
            && request.resource.data.get('status', '') == 'pending'
            && isRoomCreator(request.resource.data.roomId)
            && roomIsOpen(request.resource.data.roomId)
            && request.resource.data.role in ['editor', 'viewer']
            && request.resource.data.roomTitle is string
            && request.resource.data.roomTitle.size() > 0
            && request.resource.data.roomTitle.size() <= 80
            && request.resource.data.expiresAt > request.time
          )
        );

      // The invitee may accept or decline. The sender may cancel.
      allow update: if signedIn()
        && (
          (
            resource.data.inviteeEmail == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['accepted', 'declined', 'rejected']
          )
          || (
            resource.data.invitedBy == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );

      allow delete: if signedIn() && resource.data.invitedBy == uid();
    }

    // ---------- circles ----------
    //
    // A circle is a standing group. Membership is the whole permission model:
    // you can see a circle (and the countdowns shared with it) if your uid is
    // in `memberIds`.
    match /circles/{circleId} {
      allow read: if signedIn()
        && uid() in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      // The owner may rename or change the emoji. A member may only touch
      // `memberIds`, and only by adding or removing their own uid ------------------ that covers
      // joining by invitation and leaving, and nothing else.
      //
      // Rules have no loop, so the two allowed shapes are checked explicitly
      // rather than "the diff is exactly my uid":
      //   join  -> new list = old list + me
      //   leave -> new list = old list - me
      //
      // The join shape reads `getAfter`, not `resource`.
      //
      // `resource.data` is the state of the document **as it is committed in the
      // same batch as this write**, and the client's acceptCircleInvitation
      // batch commits the membership subcollection write first. `getAfter`
      // resolves a document as of the end of the whole batch, so it sees the
      // member row the batch just wrote; `resource.data` does not. Testing the
      // subcollection against `resource.data` is therefore always false on the
      // only path that ever adds a member this way ------------------ which is exactly the
      // `permission-denied` a new member used to get on Accept, with the circle
      // document left untouched and the membership row half-written.
      //
      // The `memberIds` diff is still computed against `resource.data`: that is
      // what actually protects against a non-owner granting themselves access,
      // and it stays exactly as strict as before.
      allow update: if signedIn()
        && (
          (resource.data.ownerId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'emoji', 'memberIds']))
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && (
              (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                && uid() in request.resource.data.memberIds
                && !(uid() in resource.data.memberIds)
                && memberRowWritten(circleId))
              || (request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                && !(uid() in request.resource.data.memberIds)
                && uid() in resource.data.memberIds)
            )
          )
        );

      allow delete: if signedIn() && resource.data.ownerId == uid();

      // Members of the circle, with names and avatars for the UI.
      match /members/{userId} {
        allow read: if signedIn()
          && (
            userId == uid()
            || (resource != null && resource.data.get('userId', '') == uid())
            || uid() in get(/databases/$(database)/documents/circles/$(circleId)).data.get('memberIds', [])
            || get(/databases/$(database)/documents/circles/$(circleId)).data.get('ownerId', '') == uid()
          );

        // You add yourself (accepting an invitation). Only the circle owner may
        // add someone else, which is what a couple auto-share does.
        allow create, update: if signedIn()
          && (
            userId == uid()
            || get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == uid()
          );

        allow delete: if signedIn()
          && (
            userId == uid()
            || get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == uid()
          );
      }
    }

    // ---------- circle invitations ----------
    match /circle_invitations/{inviteId} {
      // Readable by the sender and the invited email ------------------ nobody else. The invitee
      // is not a member yet, so this cannot be a membership check.
      allow read: if signedIn()
        && (
          resource.data.invitedBy == uid()
          || resource.data.inviteeEmail == request.auth.token.email.lower()
        );

      allow create: if signedIn()
        && request.resource.data.invitedBy == uid()
        && request.resource.data.inviteeEmail is string
        && request.resource.data.inviteeEmail == request.resource.data.inviteeEmail.lower()
        && request.resource.data.status == 'pending'
        // Only the owner of the target circle may invite into it.
        && exists(/databases/$(database)/documents/circles/$(request.resource.data.get('circleId', '')))
        && get(/databases/$(database)/documents/circles/$(request.resource.data.get('circleId', ''))).data.get('ownerId', '') == uid();

      // The invitee answers; the sender may cancel.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          resource.data.inviteeEmail == request.auth.token.email.lower()
          || resource.data.invitedBy == uid()
        );

      allow delete: if signedIn() && resource.data.invitedBy == uid();
    }

    // ---------- invitation responses ----------
    //
    // One-way feedback: "your friend joined" / "your friend declined". Only the
    // recipient reads them, and only the responder's own action creates one, so
    // a user cannot forge an answer on someone else's behalf.
    // ---------- Table Talk rooms ----------
    match /rooms/{roomId} {
      allow get, list: if signedIn()
        && (
          resource.data.get('createdBy', '') == uid()
          || uid() in resource.data.get('participantIds', [])
        );

      allow create: if signedIn()
        && request.resource.data.get('createdBy', '') == uid()
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('name', '') is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.get('description', '') is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.get('mealAt', null) is timestamp
        && request.resource.data.mealAt > request.time
        && request.resource.data.get('participantIds', null) is list
        && uid() in request.resource.data.participantIds
        && request.resource.data.get('participantCount', 0)
          == request.resource.data.participantIds.size()
        && request.resource.data.get('participantCount', 0) <= 101
        && request.resource.data.get('optionCount', 0) >= 2
        && request.resource.data.get('optionCount', 0) <= 20
        && request.resource.data.get('votesCast', -1) == 0
        && request.resource.data.get('votesRevision', -1) == 0
        && request.resource.data.get('sharedWithCrewIds', null) is list
        && request.resource.data.sharedWithCrewIds.size() <= 10
        && request.resource.data.get('createdAt', request.time) == request.time
        && request.resource.data.get('updatedAt', request.time) == request.time;

      allow update: if signedIn()
        && (
          (
            resource.data.get('createdBy', '') == uid()
            && resource.data.get('status', '') == 'open'
            && resource.data.get('votesCast', 0) == 0
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'description', 'mealAt', 'optionCount', 'updatedAt'])
            && request.resource.data.get('name', '') is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && request.resource.data.get('description', '') is string
            && request.resource.data.description.size() <= 1000
            && request.resource.data.get('mealAt', null) is timestamp
            && request.resource.data.mealAt > request.time
            && request.resource.data.get('optionCount', 0) >= 2
            && request.resource.data.get('optionCount', 0) <= 20
            && request.resource.data.updatedAt == request.time
          )
          || (
            resource.data.get('createdBy', '') == uid()
            && resource.data.get('status', '') == 'open'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'deletedAt', 'updatedAt'])
            && request.resource.data.get('status', '') == 'cancelled'
            && request.resource.data.get('deletedAt', null) == request.time
            && request.resource.data.get('updatedAt', null) == request.time
          )
          || validVoteCounterUpdate(roomId)
          || (
            resource.data.get('status', '') == 'open'
            && canReadRoom(roomId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'winnerOptionId', 'decidedAt', 'updatedAt'])
            && request.resource.data.get('status', '') == 'decided'
            && request.resource.data.get('winnerOptionId', '') is string
            && request.resource.data.winnerOptionId
              == safeDocumentId(request.resource.data.winnerOptionId)
            && exists(/databases/$(database)/documents/rooms/$(roomId)/options/$(safeDocumentId(request.resource.data.winnerOptionId)))
            && request.resource.data.get('decidedAt', null) == request.time
            && request.resource.data.get('updatedAt', null) == request.time
            && (
              resource.data.get('votesCast', 0)
                == resource.data.get('participantCount', 0)
              || request.time >= resource.data.get('mealAt', request.time)
            )
          )
          || (
            resource.data.get('status', '') == 'open'
            && roomInviteWasAccepted(roomId, uid())
            && uid() in request.resource.data.get('participantIds', [])
            && request.resource.data.get('participantCount', 0)
              == resource.data.get('participantCount', 0)
                + (roomParticipantWasAccepted(roomId, uid()) ? 0 : 1)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participantIds', 'participantCount', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
          )
          || (
            resource.data.get('status', '') == 'open'
            && roomCrewJoin(roomId, uid())
            && uid() in request.resource.data.get('participantIds', [])
            && request.resource.data.get('participantCount', 0)
              == resource.data.get('participantCount', 0)
                + (uid() in resource.data.get('participantIds', []) ? 0 : 1)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participantIds', 'participantCount', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
          )
          || (
            resource.data.get('status', '') == 'open'
            && roomCrewLeave(roomId, uid())
            && (
              (uid() in request.resource.data.get('participantIds', []))
                == roomCrewLeaveKeepsAccess(roomId, uid())
            )
            && request.resource.data.get('participantCount', 0)
              == resource.data.get('participantCount', 0)
                - (roomCrewLeaveKeepsAccess(roomId, uid()) ? 0 : 1)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participantIds', 'participantCount', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
          )
        );

      allow delete: if false;

      match /participants/{participantId} {
        allow get: if signedIn()
          && (
            participantId == uid()
            || isRoomCreator(roomId)
            || canReadRoom(roomId)
              && resource.data.get('inviteStatus', '') == 'accepted'
          );
        allow list: if canReadRoom(roomId)
          && resource.data.get('inviteStatus', '') == 'accepted';

        allow create: if signedIn()
          && (
            (
              existsAfter(roomPath(roomId))
              && getAfter(roomPath(roomId)).data.get('createdBy', '') == uid()
              && participantId in getAfter(roomPath(roomId)).data.get('participantIds', [])
              && request.resource.data.get('inviteStatus', '') == 'accepted'
              && request.resource.data.get('role', '') in ['admin', 'editor']
            )
            || (
              isRoomCreator(roomId)
              && roomIsOpen(roomId)
              && request.resource.data.get('inviteStatus', '') == 'pending'
              && roomInviteIsPending(
                request.resource.data.get('invitationId', ''),
                roomId,
                request.resource.data.get('email', '')
              )
              && getAfter(/databases/$(database)/documents/invitations/$(safeDocumentId(request.resource.data.get('invitationId', '')))).data.get('inviteeEmail', '')
                == request.resource.data.get('email', '')
            )
            || roomInviteWasAccepted(roomId, participantId)
              && roomIsOpen(roomId)
              && request.resource.data.get('email', '') == myEmail()
            || roomCrewJoin(roomId, participantId)
              && request.resource.data.get('inviteStatus', '') == 'accepted'
              && request.resource.data.get('email', '') == myEmail()
          );

        allow update: if signedIn()
          && (
            roomInviteWasAccepted(roomId, participantId)
              && roomIsOpen(roomId)
              && request.resource.data.get('inviteStatus', '') == 'accepted'
              && request.resource.data.get('email', '') == myEmail()
              && request.resource.data.get('role', '') in ['editor', 'viewer']
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['email', 'displayName', 'role', 'inviteStatus', 'joinedAt', 'isDirect', 'sourceCrewIds', 'invitationId'])
            || roomCrewJoin(roomId, participantId)
              && request.resource.data.get('inviteStatus', '') == 'accepted'
              && request.resource.data.get('email', '') == myEmail()
              && request.resource.data.get('role', '') == 'editor'
              && request.resource.data.get('lastAddedCrewId', '') in get(roomPath(roomId)).data.get('sharedWithCrewIds', [])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['email', 'displayName', 'role', 'inviteStatus', 'joinedAt', 'isDirect', 'sourceCrewIds', 'lastAddedCrewId'])
            || roomCrewLeave(roomId, participantId)
              && request.resource.data.get('lastRemovedCrewId', '') is string
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['sourceCrewIds', 'lastRemovedCrewId', 'inviteStatus'])
          );

        allow delete: if false;
      }

      match /options/{optionId} {
        allow read: if canReadRoom(roomId);

        allow create: if canManageRoomOptions(roomId)
          && request.resource.data.get('createdBy', '') == uid()
          && request.resource.data.get('title', '') is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && (
            request.resource.data.get('url', null) is string
            || request.resource.data.get('url', null) == null
          )
          && (
            request.resource.data.get('address', null) is string
            || request.resource.data.get('address', null) == null
          )
          && request.resource.data.get('voteCount', -1) == 0
          && request.resource.data.get('createdAt', request.time) == request.time;

        allow update: if signedIn()
          && canReadRoom(roomId)
          && get(roomPath(roomId)).data.get('status', '') == 'open'
          && uid() in get(roomPath(roomId)).data.get('participantIds', [])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['voteCount'])
          && (
            (
              existsAfter(/databases/$(database)/documents/rooms/$(roomId)/votes/$(uid()))
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)/votes/$(uid())).data.get('optionId', '') == optionId
              && (
                !exists(/databases/$(database)/documents/rooms/$(roomId)/votes/$(uid()))
                || get(/databases/$(database)/documents/rooms/$(roomId)/votes/$(uid())).data.get('optionId', '') != optionId
              )
              && request.resource.data.get('voteCount', 0) == resource.data.get('voteCount', 0) + 1
            )
            || (
              exists(/databases/$(database)/documents/rooms/$(roomId)/votes/$(uid()))
              && get(/databases/$(database)/documents/rooms/$(roomId)/votes/$(uid())).data.get('optionId', '') == optionId
              && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/votes/$(uid()))
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)/votes/$(uid())).data.get('optionId', '') != optionId
              && request.resource.data.get('voteCount', 0) == resource.data.get('voteCount', 0) - 1
            )
          )
          && request.resource.data.get('voteCount', 0) >= 0;

        allow delete: if signedIn()
          && isRoomCreator(roomId)
          && roomIsOpen(roomId)
          && get(roomPath(roomId)).data.get('votesCast', 0) == 0;
      }

      match /votes/{voterId} {
        allow read: if canReadRoom(roomId);
        allow create, update: if signedIn()
          && voterId == uid()
          && canReadRoom(roomId)
          && roomIsOpen(roomId)
          && uid() in get(roomPath(roomId)).data.get('participantIds', [])
          && request.resource.data.get('userId', '') == uid()
          && request.resource.data.get('optionId', '') is string
          && exists(/databases/$(database)/documents/rooms/$(roomId)/options/$(safeDocumentId(request.resource.data.optionId)))
          && request.resource.data.get('createdAt', request.time) == request.time;
        allow delete: if false;
      }

      match /notes/{noteId} {
        allow read: if canReadRoom(roomId);
        allow create: if signedIn()
          && canReadRoom(roomId)
          && uid() in get(roomPath(roomId)).data.get('participantIds', [])
          && request.resource.data.get('userId', '') == uid()
          && request.resource.data.get('text', '') is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.get('createdAt', request.time) == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- Table Talk crews ----------
    match /crews/{crewId} {
      allow get, list: if signedIn()
        && uid() in resource.data.get('memberIds', []);

      allow create: if signedIn()
        && request.resource.data.get('ownerId', '') == uid()
        && request.resource.data.get('memberIds', []) == [uid()]
        && request.resource.data.get('name', '') is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.get('isCouple', false) is bool
        && request.resource.data.get('createdAt', request.time) == request.time;

      allow update: if signedIn()
        && (
          resource.data.get('ownerId', '') == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name'])
          && request.resource.data.get('name', '') is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          || (
            !(uid() in resource.data.get('memberIds', []))
            && uid() in request.resource.data.get('memberIds', [])
            && request.resource.data.get('memberIds', []).size()
              == resource.data.get('memberIds', []).size() + 1
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'lastInvitationId'])
            && crewInvitationCanBeAccepted(
              crewId,
              request.resource.data.get('lastInvitationId', ''),
              uid()
            )
            && (
              resource.data.get('isCouple', false) != true
              || resource.data.get('memberIds', []).size() < 2
            )
          )
          || (
            resource.data.get('ownerId', '') != uid()
            && uid() in resource.data.get('memberIds', [])
            && !(uid() in request.resource.data.get('memberIds', []))
            && request.resource.data.get('memberIds', []).size()
              == resource.data.get('memberIds', []).size() - 1
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds'])
          )
        );

      allow delete: if false;

      match /members/{memberId} {
        allow get, list: if signedIn()
          && uid() in get(/databases/$(database)/documents/crews/$(crewId)).data.get('memberIds', []);

        allow create: if signedIn()
          && (
            existsAfter(/databases/$(database)/documents/crews/$(crewId))
            && getAfter(/databases/$(database)/documents/crews/$(crewId)).data.get('ownerId', '') == uid()
            && memberId == uid()
            && request.resource.data.get('isOwner', false) == true
            || memberId == uid()
              && crewInvitationCanBeAccepted(
                crewId,
                request.resource.data.get('invitationId', ''),
                memberId
              )
              && request.resource.data.get('isOwner', true) == false
          )
          && request.resource.data.get('email', '') == myEmail()
          && request.resource.data.get('joinedAt', request.time) == request.time;

        allow update: if signedIn()
          && memberId == uid()
          && crewInvitationCanBeAccepted(
            crewId,
            request.resource.data.get('invitationId', ''),
            memberId
          )
          && request.resource.data.get('email', '') == myEmail();

        allow delete: if signedIn()
          && memberId == uid()
          && exists(/databases/$(database)/documents/crews/$(crewId)/members/$(memberId));
      }

      match /sharedRooms/{roomId} {
        allow get, list: if signedIn()
          && uid() in get(/databases/$(database)/documents/crews/$(crewId)).data.get('memberIds', []);

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/crews/$(crewId)/members/$(uid()))
          && existsAfter(roomPath(roomId))
          && getAfter(roomPath(roomId)).data.get('createdBy', '') == uid()
          && crewId in getAfter(roomPath(roomId)).data.get('sharedWithCrewIds', [])
          && request.resource.data.get('roomId', '') == roomId
          && request.resource.data.get('sharedWithCrewIds', []) is list
          && crewId in request.resource.data.sharedWithCrewIds
          && request.resource.data.get('createdAt', request.time) == request.time;

        allow update, delete: if false;
      }
    }

    match /crew_invitations/{inviteId} {
      allow get, list: if signedIn()
        && (
          resource.data.get('invitedBy', '') == uid()
          || resource.data.get('inviteeEmail', '') == myEmail()
        );

      allow create: if signedIn()
        && request.resource.data.get('invitedBy', '') == uid()
        && request.resource.data.get('inviteeEmail', '') is string
        && request.resource.data.inviteeEmail == request.resource.data.inviteeEmail.lower()
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('crewId', '') == safeDocumentId(request.resource.data.crewId)
        && exists(/databases/$(database)/documents/crews/$(request.resource.data.crewId))
        && get(/databases/$(database)/documents/crews/$(request.resource.data.crewId)).data.get('ownerId', '') == uid()
        && request.resource.data.get('expiresAt', request.time) > request.time;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          resource.data.get('inviteeEmail', '') == myEmail()
            && resource.data.get('status', '') == 'pending'
            && request.resource.data.get('status', '') in ['accepted', 'declined']
          || resource.data.get('invitedBy', '') == uid()
            && request.resource.data.get('status', '') == 'cancelled'
        );

      allow delete: if false;
    }

    match /responses/{responseId} {
      allow read: if signedIn() && resource.data.recipientId == uid();

      allow create: if signedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.responderEmail == request.auth.token.email.lower()
        && request.resource.data.accepted is bool
        && request.resource.data.read == false;

      // Only the recipient may mark it read.
      allow update: if signedIn()
        && resource.data.recipientId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if signedIn() && resource.data.recipientId == uid();
    }

    // Everything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
